# Скопируйте в .env и заполните под своё окружение.

# Безопасность
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# CORS: домены фронтенда (через запятую). В DEBUG при пустом значении разрешены все.
CORS_ALLOWED_ORIGINS=
# CSRF: доверенные origin для прод (например, https://your-app.pages.dev)
CSRF_TRUSTED_ORIGINS=

# База данных (по умолчанию sqlite). Пример: postgres://user:pass@host:5432/dbname
# DATABASE_URL=

# Telegram Mini-App
TELEGRAM_BOT_TOKEN=
# Разрешать определять пользователя по telegram_id из запроса без подписи (только dev!).
# В проде поставьте False, чтобы требовать проверенный initData.
TELEGRAM_ALLOW_INSECURE=True
